{
  "schemaVersion": 1,
  "id": "airswap",
  "version": "${version}",
  "name": "Air Swap",
  "icon": "assets/airswap/icon.png",
  "description": "Client-side airborne sword/spear-to-mace switching with automatic returns, Breach-aware selection, durability protection, and optional gameplay filters. Use only where the server permits combat automation; the server controls attack outcomes.",
  "authors": ["voidles02"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.KDI.airswap.AirSwapClient"],
    "modmenu": ["dev.KDI.airswap.config.AirSwapModMenu"]
  },
  "mixins": [
    {
      "config": "airswap.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=17.0.0",
    "yet_another_config_lib_v3": ">=3.8.0"
  }
}